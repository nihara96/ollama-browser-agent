{
  "name": "ollama-browser-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that lets local Ollama models operate your browser, plus an MCP bridge for clients like Continue.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p ollama-agent/tsconfig.json && tsc -p mcp-bridge/tsconfig.json",
    "clean": "node -e \"for (const d of ['ollama-agent/dist','mcp-bridge/dist']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "start:bridge": "node mcp-bridge/dist/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
